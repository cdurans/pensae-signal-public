# Fedora-hosted application and loopback services. Run make configure-secrets.
PENSAE_ENVIRONMENT=development
PENSAE_APP_HOST=127.0.0.1
PENSAE_APP_PORT=8000
PENSAE_POSTGRES_DSN=
PENSAE_REDIS_URL=redis://127.0.0.1:6379/0
PENSAE_SEARXNG_URL=http://127.0.0.1:8888
PENSAE_CHAT_URL=http://127.0.0.1:8085
PENSAE_EMBEDDING_URL=http://127.0.0.1:8086
PENSAE_DATA_DIR=.pensae/data
PENSAE_LOG_DIR=.pensae/logs
PENSAE_OWNERSHIP_DIR=.pensae/ownership
PENSAE_VERBOSE_LOGGING=false

# Protected installation paths. Never expose these through the browser or commit real values.
PENSAE_LLAMA_EXECUTABLE=/absolute/path/to/llama-server
PENSAE_CHAT_MODEL_PATH=/absolute/path/to/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf
PENSAE_EMBEDDING_MODEL_PATH=/absolute/path/to/Qwen3-Embedding-0.6B-Q8_0.gguf

# Installation secrets are generated in the ignored .env, never in this template.
POSTGRES_USER=pensae
POSTGRES_PASSWORD=
POSTGRES_DB=pensae
SEARXNG_SECRET=
